/secrets/
.env

# PID files and runtime artifacts
*.pid

# Editor/IDE files
.vscode/
.idea/
*.swp
*~

# Ignore compiled binaries and miscellaneous artifacts
*.exe
*.dll
*.so
*.dylib
/build/

# Keep Cargo.toml/Cargo.lock and source files tracked
src/web_routes.rs
data